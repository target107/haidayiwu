<view class="page page-login">
  <view class="login-brand">
    <view class="login-logo">易</view>
    <view class="login-name">{{appName}}</view>
    <view class="login-sub">{{subtitle}}</view>
  </view>

  <view class="login-card card">
    <view class="field">
      <text class="field-label">学号</text>
      <input class="field-input"
             value="{{studentId}}"
             type="number"
             maxlength="12"
             placeholder="12 位学号"
             bindinput="onStudentIdInput" />
    </view>

    <view class="field">
      <text class="field-label">密码</text>
      <input class="field-input"
             value="{{password}}"
             password="true"
             maxlength="32"
             placeholder="请输入密码"
             bindinput="onPasswordInput" />
    </view>

    <view class="btn-primary login-btn" bindtap="onSubmit">{{submitting ? '登录中…' : '登录'}}</view>
  </view>

  <view class="login-register">
    <text class="login-register-text">还没有账号？</text>
    <text class="login-register-link" bindtap="onGoRegister">注册一个账号</text>
  </view>
</view>
