/* 登录：品牌区 + 一张表单卡片 + 底部「注册一个账号」入口 */

.page-login {
  display: flex;
  flex-direction: column;
  padding: 72rpx 40rpx 48rpx;
  box-sizing: border-box;
}

.login-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}

.login-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  border-radius: 36rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 60rpx;
  font-weight: 700;
}

.login-name {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.login-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.login-card {
  padding: 36rpx 32rpx 32rpx;
}

.login-btn {
  margin-top: 12rpx;
}

.login-register {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
}

.login-register-text {
  font-size: 26rpx;
  color: #6b7280;
}

.login-register-link {
  padding: 12rpx 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f766e;
}
