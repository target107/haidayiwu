/* 详情页：整宽封面 + 卡片信息块 + 底部固定操作条 */

.page-detail {
  padding-bottom: 280rpx;
}

.detail-cover {
  width: 100%;
  height: 440rpx;
  border-radius: 0;
}

.detail-cover .cover-char {
  font-size: 112rpx;
}

.detail-main {
  display: flex;
  flex-direction: column;
  padding: 28rpx 28rpx 40rpx;
}

.detail-title-row {
  display: flex;
  align-items: flex-start;
}

.detail-title {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

/* 下架 / 已售出标记：跟在标题后面，不占按钮位置 */
.state-tag {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 2rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  line-height: 1.8;
}

.state-off {
  background: #f1f3f5;
  color: #6b7280;
}

.state-sold {
  background: #fff7ed;
  color: #b45309;
}

.detail-price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
}

.detail-price {
  color: #d9480f;
  font-size: 48rpx;
  font-weight: 700;
}

.detail-views {
  font-size: 24rpx;
  color: #9aa2ab;
}

.attr-list {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
}

.attr-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.attr-key {
  color: #6b7280;
}

.attr-value {
  font-weight: 600;
}

.seller-card {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 24rpx;
}

.seller-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #ccfbf1;
  color: #115e59;
  font-weight: 700;
}

.seller-info {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 20rpx;
}

.seller-name {
  font-size: 28rpx;
  font-weight: 600;
}

.seller-note {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.desc-block {
  margin-top: 24rpx;
  padding: 24rpx;
}

.desc-title {
  font-size: 28rpx;
  font-weight: 600;
}

.desc-text {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #3f4a55;
}

.detail-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx 28rpx;
  background: #ffffff;
  border-top: 1rpx solid #e6eaee;
}

.safe-tip {
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #fde68a;
  border-radius: 16rpx;
  background: #fffbeb;
  color: #b45309;
  font-size: 22rpx;
  line-height: 1.4;
}

/* 返回首页：对所有详情页都可用（发布成功想回主菜单时最省事） */
.home-btn {
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.detail-actions {
  display: flex;
  align-items: center;
}

.fav-btn {
  flex: 0 0 auto;
}

.fav-star {
  margin-right: 8rpx;
  font-size: 26rpx;
}

.btn-ghost.is-fav .fav-star {
  color: #f97316;
}

.detail-contact {
  flex: 1 1 auto;
  margin-left: 20rpx;
}

/* 自己发布的物品：按钮位置换成不可点的标签 */
.self-tag {
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  padding: 22rpx 36rpx;
  border: 1rpx dashed #d1d5db;
  border-radius: 999rpx;
  background: #f1f3f5;
  color: #9aa2ab;
  font-size: 28rpx;
  font-weight: 600;
}