/* 详情页：整宽封面 + 卡片信息块 + 底部固定操作条 */

.page-detail {
  padding-bottom: 280rpx;
}

.detail-cover {
  width: 100%;
  height: 440rpx;
  border-radius: 0;
}

.detail-cover .cover-char {
  font-size: 112rpx;
}

.detail-main {
  display: flex;
  flex-direction: column;
  padding: 28rpx 28rpx 40rpx;
}

.detail-title-row {
  display: flex;
  align-items: flex-start;
}

.detail-title {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

/* 下架 / 已售出标记：跟在标题后面，不占按钮位置 */
.state-tag {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 2rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  line-height: 1.8;
}

.state-off {
  background: #f1f3f5;
  color: #6b7280;
}

.state-sold {
  background: #fff7ed;
  color: #b45309;
}

.detail-price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
}

.detail-price {
  color: #d9480f;
  font-size: 48rpx;
  font-weight: 700;
}

.detail-views {
  font-size: 24rpx;
  color: #9aa2ab;
}

.attr-list {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
}

.attr-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.attr-key {
  color: #6b7280;
}

.attr-value {
  font-weight: 600;
}

.seller-card {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 24rpx;
}

.seller-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #ccfbf1;
  color: #115e59;
  font-weight: 700;
}

.seller-info {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 20rpx;
}

.seller-name {
  font-size: 28rpx;
  font-weight: 600;
}

.seller-note {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.desc-block {
  margin-top: 24rpx;
  padding: 24rpx;
}

.desc-title {
  font-size: 28rpx;
  font-weight: 600;
}

.desc-text {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #3f4a55;
}

.detail-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx 28rpx;
  background: #ffffff;
  border-top: 1rpx solid #e6eaee;
}

.safe-tip {
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #fde68a;
  border-radius: 16rpx;
  background: #fffbeb;
  color: #b45309;
  font-size: 22rpx;
  line-height: 1.4;
}

/* 返回首页：对所有详情页都可用（发布成功想回主菜单时最省事） */
.home-btn {
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.detail-actions {
  display: flex;
  align-items: center;
}

.fav-btn {
  flex: 0 0 auto;
}

.fav-star {
  margin-right: 8rpx;
  font-size: 26rpx;
}

.btn-ghost.is-fav .fav-star {
  color: #f97316;
}

.detail-contact {
  flex: 1 1 auto;
  margin-left: 20rpx;
}

/* 自己发布的物品：按钮位置换成不可点的标签 */
.self-tag {
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  padding: 22rpx 36rpx;
  border: 1rpx dashed #d1d5db;
  border-radius: 999rpx;
  background: #f1f3f5;
  color: #9aa2ab;
  font-size: 28rpx;
  font-weight: 600;
}

/* ---------- 举报入口：标题右侧的小字按钮，刻意做得不抢眼 ---------- */
.report-link {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 4rpx 0;
  color: #9aa2ab;
  font-size: 22rpx;
  text-decoration: underline;
}

/* ---------- 评价卖家入口 ---------- */
.rate-entry {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 24rpx;
}

.rate-entry-body {
  flex: 1 1 auto;
  min-width: 0;
  margin-right: 20rpx;
}

.rate-entry-title {
  font-size: 28rpx;
  font-weight: 600;
}

.rate-entry-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6b7280;
}

/* 已评价：变灰，但仍可点击（点了会提示「你已经评价过了」） */
.is-disabled {
  background: #e5e9ec;
  color: #9aa2ab;
}

/* ---------- 评论区 ---------- */
.comment-block {
  margin-top: 24rpx;
  padding: 24rpx;
}

.cmt-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.cmt-title {
  font-size: 28rpx;
  font-weight: 600;
}

.cmt-count {
  font-size: 22rpx;
  color: #9aa2ab;
}

.comment-list {
  margin-top: 12rpx;
}

.comment-item {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1f3f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #ccfbf1;
  color: #115e59;
  font-size: 24rpx;
  font-weight: 700;
}

.comment-body {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 18rpx;
}

.cmt-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.comment-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2933;
}

.comment-time {
  font-size: 20rpx;
  color: #9aa2ab;
}

.comment-text {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #3f4a55;
  word-break: break-all;
}

.comment-empty {
  padding: 40rpx 0;
  text-align: center;
}

.comment-empty-text {
  font-size: 24rpx;
  color: #9aa2ab;
}

.comment-form {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f1f3f5;
}

.comment-input {
  flex: 1 1 auto;
  min-width: 0;
  padding: 16rpx 24rpx;
  border: 1rpx solid #e6eaee;
  border-radius: 999rpx;
  background: #f7f9fa;
  font-size: 26rpx;
}

.comment-send {
  flex: 0 0 auto;
  margin-left: 16rpx;
}

/* ---------- 评分弹层 ---------- */
.rate-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(15, 23, 42, 0.45);
}

.rate-panel {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 50%;
  z-index: 91;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  transform: translateY(-50%);
}

.rate-panel-title {
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}

.rate-stars {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

.rate-star {
  padding: 0 12rpx;
  color: #d1d5db;
  font-size: 64rpx;
  line-height: 1.2;
}

.rate-star.is-on {
  color: #f59e0b;
}

.rate-score-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9aa2ab;
  text-align: center;
}

.rate-input {
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  border: 1rpx solid #e6eaee;
  border-radius: 20rpx;
  background: #f7f9fa;
  font-size: 26rpx;
}

.rate-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.rate-actions .btn-ghost {
  flex: 0 0 auto;
}

.rate-submit {
  flex: 0 0 auto;
  margin-left: 20rpx;
}
