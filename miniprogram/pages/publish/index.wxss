/* 发布页：字段卡片式表单，错误提示贴在字段下方 */

.form {
  display: flex;
  flex-direction: column;
  padding: 28rpx;
}

.field-textarea {
  min-height: 136rpx;
  line-height: 1.6;
}

.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value {
  font-size: 28rpx;
  color: #1f2933;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #9aa2ab;
}

.picker-arrow {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #9aa2ab;
}

.image-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  padding: 32rpx 24rpx;
  border: 1rpx dashed #c3ccd4;
  border-radius: 20rpx;
  background: #fafcfc;
}

.image-hint {
  font-size: 24rpx;
  color: #6b7280;
}

.image-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 192rpx;
  margin-top: 12rpx;
  border-radius: 20rpx;
  background: #f7f9fa;
  overflow: hidden;
}

.image-preview.has-image {
  background: #eef2f4;
}

.image-preview-img {
  width: 100%;
  height: 100%;
}

.image-preview-text {
  font-size: 24rpx;
  color: #9aa2ab;
}

.form-tip {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}

.submit-btn {
  margin-top: 28rpx;
}
