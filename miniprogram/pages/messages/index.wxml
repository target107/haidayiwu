<view class="page page-messages">
  <view class="messages-head">
    <text class="messages-head-title">消息中心</text>
    <text class="messages-head-sub" wx:if="{{unreadTotal}}">{{unreadTotal}} 个会话有未读</text>
    <text class="messages-head-sub" wx:else>没有未读消息</text>
  </view>

  <view class="empty" wx:if="{{loading}}">
    <view class="empty-main">加载中…</view>
  </view>

  <view class="conv-list" wx:if="{{!loading && conversations.length}}">
    <view class="conv-item card"
          wx:for="{{conversations}}"
          wx:key="key"
          data-item-id="{{item.itemId}}"
          data-buyer-id="{{item.buyerId}}"
          bindtap="goChat">
      <view class="conv-avatar">{{item.avatarChar}}</view>
      <view class="conv-body">
        <view class="conv-line">
          <text class="conv-name">{{item.counterpartName}}</text>
          <text class="conv-time">{{item.lastAtText}}</text>
        </view>
        <view class="conv-item-title">{{item.itemTitle}}</view>
        <view class="conv-line">
          <text class="conv-text">{{item.lastText}}</text>
          <text class="conv-badge" wx:if="{{item.unread}}">{{item.unreadText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !conversations.length}}">
    <view class="empty-main">{{emptyText}}</view>
    <view class="empty-sub">在商品详情点「联系卖家」就会在这里出现</view>
  </view>
</view>
