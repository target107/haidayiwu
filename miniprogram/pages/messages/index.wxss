/* 消息中心：会话列表，未读数用主色实心小红点 */
.page-messages {
  padding-bottom: 40rpx;
}

.messages-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 28rpx 28rpx 16rpx;
}

.messages-head-title {
  font-size: 34rpx;
  font-weight: 700;
}

.messages-head-sub {
  font-size: 24rpx;
  color: #6b7280;
}

.conv-list {
  padding: 0 24rpx;
}

.conv-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.conv-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #ccfbf1;
  color: #115e59;
  font-size: 32rpx;
  font-weight: 600;
}

.conv-body {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 20rpx;
}

.conv-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.conv-name {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.conv-time {
  flex: 0 0 auto;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #9aa2ab;
}

.conv-item-title {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #0f766e;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.conv-text {
  flex: 1 1 auto;
  min-width: 0;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6b7280;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.conv-badge {
  flex: 0 0 auto;
  min-width: 32rpx;
  margin-left: 12rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}
