/* 浏览记录：标题 + 右上角「清空」按钮 + 商品列表（封面 / 标题 / 价格 / 校区 / 浏览时间） */
.page-history {
  padding-bottom: 40rpx;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 8rpx;
}

.history-head-title {
  font-size: 34rpx;
  font-weight: 700;
}

.history-clear {
  padding: 8rpx 26rpx;
  border: 1rpx solid #0f766e;
  border-radius: 999rpx;
  color: #0f766e;
  font-size: 24rpx;
}

.history-head-sub {
  padding: 0 28rpx 20rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.rec-list {
  padding: 0 24rpx;
}

.rec-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 20rpx;
}

.rec-thumb {
  flex: 0 0 auto;
  width: 148rpx;
  height: 148rpx;
}

.rec-thumb .cover-char {
  font-size: 44rpx;
}

.rec-body {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 20rpx;
}

.rec-title {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rec-price {
  margin-top: 6rpx;
  color: #d9480f;
  font-size: 30rpx;
  font-weight: 700;
}

.rec-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.rec-campus {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rec-time {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #9aa2ab;
}
