/* 私信页：整屏纵向布局，中间消息区滚动，底部输入条固定 */

.page-chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.chat-head {
  padding: 20rpx 28rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e6eaee;
}

.chat-title {
  font-size: 28rpx;
  font-weight: 600;
}

.chat-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6b7280;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 安全提示条：常驻在头部下方，不占消息列表 */
.chat-hint {
  padding: 12rpx 28rpx;
  background: #f0fdfa;
  color: #115e59;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

/* 卖家专用：确认交易完成 */
.chat-sold-bar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 12rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e6eaee;
}

.chat-list {
  flex: 1 1 auto;
  height: 0;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
}

.msg {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.msg-seller {
  flex-direction: row;
}

.msg-me {
  flex-direction: row-reverse;
}

.msg-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e5e9ec;
  color: #4b5563;
  font-size: 24rpx;
}

.msg-me .msg-avatar {
  background: #ccfbf1;
  color: #115e59;
}

.msg-body {
  display: flex;
  flex-direction: column;
  max-width: 74%;
  margin: 0 16rpx;
}

.msg-me .msg-body {
  align-items: flex-end;
}

.msg-bubble {
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  font-size: 28rpx;
  line-height: 1.5;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.06);
  word-break: break-all;
}

.msg-me .msg-bubble {
  background: #0f766e;
  color: #ffffff;
}

.msg-time {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9aa2ab;
}

.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #e6eaee;
}

.chat-input {
  flex: 1 1 auto;
  min-width: 0;
  padding: 18rpx 24rpx;
  border: 1rpx solid #e6eaee;
  border-radius: 999rpx;
  background: #f7f9fa;
  font-size: 28rpx;
}

.send-btn {
  flex: 0 0 auto;
  margin-left: 16rpx;
}