/* 私信页：整屏纵向布局，中间消息区滚动，底部输入条固定 */

.page-chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.chat-head {
  padding: 20rpx 28rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e6eaee;
}

.chat-title {
  font-size: 28rpx;
  font-weight: 600;
}

.chat-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6b7280;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 安全提示条：常驻在头部下方，不占消息列表 */
.chat-hint {
  padding: 12rpx 28rpx;
  background: #f0fdfa;
  color: #115e59;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

/* 卖家专用：确认交易完成 */
.chat-sold-bar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 12rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e6eaee;
}

.chat-list {
  flex: 1 1 auto;
  height: 0;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
}

.msg {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.msg-seller {
  flex-direction: row;
}

.msg-me {
  flex-direction: row-reverse;
}

.msg-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e5e9ec;
  color: #4b5563;
  font-size: 24rpx;
}

.msg-me .msg-avatar {
  background: #ccfbf1;
  color: #115e59;
}

.msg-body {
  display: flex;
  flex-direction: column;
  max-width: 74%;
  margin: 0 16rpx;
}

.msg-me .msg-body {
  align-items: flex-end;
}

.msg-bubble {
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  font-size: 28rpx;
  line-height: 1.5;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.06);
  word-break: break-all;
}

.msg-me .msg-bubble {
  background: #0f766e;
  color: #ffffff;
}

.msg-time {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9aa2ab;
}

.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #e6eaee;
}

.chat-input {
  flex: 1 1 auto;
  min-width: 0;
  padding: 18rpx 24rpx;
  border: 1rpx solid #e6eaee;
  border-radius: 999rpx;
  background: #f7f9fa;
  font-size: 28rpx;
}

.send-btn {
  flex: 0 0 auto;
  margin-left: 16rpx;
}

/* 已评价买家：变灰，但仍可点击（点了会提示「你已经评价过了」） */
.is-disabled {
  background: #e5e9ec;
  color: #9aa2ab;
}

/* ---------- 评分弹层（与详情页同一套样式） ---------- */
.rate-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(15, 23, 42, 0.45);
}

.rate-panel {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 50%;
  z-index: 91;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  transform: translateY(-50%);
}

.rate-panel-title {
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}

.rate-stars {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

.rate-star {
  padding: 0 12rpx;
  color: #d1d5db;
  font-size: 64rpx;
  line-height: 1.2;
}

.rate-star.is-on {
  color: #f59e0b;
}

.rate-score-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9aa2ab;
  text-align: center;
}

.rate-input {
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  border: 1rpx solid #e6eaee;
  border-radius: 20rpx;
  background: #f7f9fa;
  font-size: 26rpx;
}

.rate-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.rate-actions .btn-ghost {
  flex: 0 0 auto;
}

.rate-submit {
  flex: 0 0 auto;
  margin-left: 20rpx;
}
