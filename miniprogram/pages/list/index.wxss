/* 首页：顶部品牌区 + 三行筛选 + 商品卡片列表（H5 的 375px 尺寸 ×2 换成 rpx） */

.list-head {
  padding: 28rpx 28rpx 20rpx;
  background: linear-gradient(180deg, #0f766e 0%, #0e7490 100%);
  color: #ffffff;
}

.brand {
  display: flex;
  align-items: baseline;
}

.brand-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.brand-sub {
  margin-left: 16rpx;
  font-size: 24rpx;
  opacity: 0.82;
}

.search-box {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.95);
}

.search-input {
  flex: 1 1 auto;
  font-size: 26rpx;
  color: #1f2933;
}

.filter-block {
  padding: 16rpx 0 8rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e6eaee;
}

.filter-row {
  display: flex;
  align-items: flex-start;
  padding-left: 24rpx;
}

.filter-label {
  flex: 0 0 auto;
  width: 60rpx;
  padding-top: 14rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.chip-scroll {
  flex: 1 1 auto;
  width: 0;
  padding: 8rpx 0;
  white-space: nowrap;
}

.chip {
  display: inline-block;
  margin-right: 14rpx;
  padding: 10rpx 22rpx;
  border: 1rpx solid #e6eaee;
  border-radius: 999rpx;
  background: #f7f9fa;
  font-size: 24rpx;
  color: #6b7280;
}

.chip.is-active {
  border-color: #0f766e;
  background: #0f766e;
  color: #ffffff;
  font-weight: 600;
}

.list-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx 4rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.link-btn {
  color: #0f766e;
  font-size: 24rpx;
}

.item-list {
  display: flex;
  flex-direction: column;
  padding: 16rpx 24rpx 40rpx;
}

.item-card {
  display: flex;
  margin-bottom: 20rpx;
  padding: 20rpx;
}

.item-cover {
  flex: 0 0 auto;
  width: 176rpx;
  height: 176rpx;
}

.item-body {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-price-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.item-price {
  color: #d9480f;
  font-size: 32rpx;
  font-weight: 700;
}

.item-condition {
  margin-left: 16rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #ccfbf1;
  color: #115e59;
  font-size: 22rpx;
}

.item-campus {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.item-foot {
  display: flex;
  justify-content: space-between;
  margin-top: auto;
  font-size: 22rpx;
  color: #9aa2ab;
}
