<view class="page page-list">
  <view class="list-head">
    <view class="brand">
      <text class="brand-title">海大易物</text>
      <text class="brand-sub">中国海洋大学 · 校园二手</text>
    </view>
    <view class="search-box">
      <input class="search-input"
             value="{{keyword}}"
             type="text"
             confirm-type="search"
             placeholder="搜索物品名称或描述"
             bindinput="onKeywordInput" />
    </view>
  </view>

  <view class="filter-block">
    <view class="filter-row">
      <text class="filter-label">分类</text>
      <scroll-view class="chip-scroll" scroll-x>
        <view class="chip {{category === item ? 'is-active' : ''}}"
              wx:for="{{categoryChips}}"
              wx:key="*this"
              data-value="{{item}}"
              bindtap="onCategoryTap">{{item}}</view>
      </scroll-view>
    </view>
    <view class="filter-row">
      <text class="filter-label">成色</text>
      <scroll-view class="chip-scroll" scroll-x>
        <view class="chip {{condition === item ? 'is-active' : ''}}"
              wx:for="{{conditionChips}}"
              wx:key="*this"
              data-value="{{item}}"
              bindtap="onConditionTap">{{item}}</view>
      </scroll-view>
    </view>
    <view class="filter-row">
      <text class="filter-label">价格</text>
      <scroll-view class="chip-scroll" scroll-x>
        <view class="chip {{price === item ? 'is-active' : ''}}"
              wx:for="{{priceChips}}"
              wx:key="*this"
              data-value="{{item}}"
              bindtap="onPriceTap">{{item}}</view>
      </scroll-view>
    </view>
    <view class="filter-row">
      <text class="filter-label">校区</text>
      <scroll-view class="chip-scroll" scroll-x>
        <view class="chip {{campus === item ? 'is-active' : ''}}"
              wx:for="{{campusChips}}"
              wx:key="*this"
              data-value="{{item}}"
              bindtap="onCampusTap">{{item}}</view>
      </scroll-view>
    </view>
  </view>

  <view class="list-meta">
    <text>{{countText}}</text>
    <text class="link-btn" bindtap="onResetTap">清空筛选</text>
  </view>

  <view class="item-list">
    <view class="item-card card"
          wx:for="{{items}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="goDetail">
      <view class="cover item-cover" style="background:{{item.coverBg}}">
        <image class="cover-img" wx:if="{{item.coverImage}}" src="{{item.coverImage}}" mode="aspectFill" />
        <text class="cover-char" wx:else>{{item.coverChar}}</text>
      </view>
      <view class="item-body">
        <view class="item-title">{{item.title}}</view>
        <view class="item-price-row">
          <text class="item-price">{{item.priceText}}</text>
          <text class="item-condition">{{item.condition}}</text>
        </view>
        <view class="item-campus">{{item.campus}}</view>
        <view class="item-foot">
          <text>{{item.sellerName}}</text>
          <text>{{item.timeText}}</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && !items.length}}">
      <view class="empty-main">没有找到相关物品，换个关键词试试</view>
      <view class="empty-sub">也可以点「清空筛选」看看全部物品</view>
    </view>
  </view>
</view>
